# Required environment variables for JASPER

# NVIDIA NIM configuration (required when LLM_PROVIDER=nvidia).
# Hosted models are retired periodically; pick a current one from https://integrate.api.nvidia.com/v1/models
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b

# LLM provider: nvidia | offline (deterministic narrator, no network)
# LLM_PROVIDER=nvidia

# Research agent bounds
# RESEARCH_MAX_ITERATIONS=3
# RESEARCH_MAX_TOOL_CALLS=80
# RESEARCH_MAX_LLM_TOOL_STEPS=4
# RESEARCH_MAX_NARRATIVE_ATTEMPTS=2

# Replay frozen fixtures instead of live Yahoo Finance (reproducible runs)
# RESEARCH_FIXTURE_DIR=benchmarks/v1/fixtures

# Legacy one-shot LLM code generation (outputs attached as unverified supplementary analysis)
# ENABLE_CODEGEN_ANALYSIS=false

# Optional: Application Settings
# LOG_LEVEL=INFO
# API_PREFIX=/v1
# ENABLE_PROMETHEUS=true
# ARTIFACT_STORE_PATH=./data/artifacts
